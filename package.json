{
  "name": "verse",
  "version": "0.0.1",
  "devDependencies": {
    "bun-types": "^1.3.14",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.4.2",
  "private": true,
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "lint": "oxlint -c .oxlintrc.json",
    "lint:fix": "oxlint -c .oxlintrc.json --fix",
    "fmt": "oxfmt -c .oxfmtrc.json",
    "fmt:check": "oxfmt -c .oxfmtrc.json --check",
    "fix": "oxlint -c .oxlintrc.json --fix && oxfmt -c .oxfmtrc.json",
    "typecheck": "tsc -p tsconfig.json && cd web && bun run typecheck",
    "check": "bun run fmt:check && bun run lint && bun run typecheck && bun test",
    "eval": "bun api/scripts/eval.ts",
    "db:migrate": "bun api/scripts/migrate.ts",
    "db:import": "bun api/scripts/import.ts"
  },
  "type": "module",
  "workspaces": [
    "shared",
    "api",
    "web"
  ]
}
