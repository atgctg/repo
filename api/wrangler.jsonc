{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "verse-api",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat"],
  "placement": {
    "region": "aws:us-east-2",
  },
  "observability": {
    "enabled": true,
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "5101227e042e4f7a8f4c4af7ec6252df",
    },
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "verse-assets",
    },
  ],
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.md"],
      "fallthrough": true,
    },
  ],
}
