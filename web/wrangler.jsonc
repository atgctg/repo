{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "verse-web",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": {
    "enabled": true,
  },
  "services": [
    {
      "binding": "API",
      "service": "verse-api",
    },
  ],
  "previews": {},
}
