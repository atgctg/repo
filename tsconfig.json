{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["bun-types"],
    "paths": {
      "shared": ["./shared/index.ts"],
      "shared/contract": ["./shared/contract.ts"]
    }
  },
  "include": ["shared/**/*.ts", "api/**/*.ts", "api/**/*.d.ts"]
}
